import random
import matplotlib.pyplot as plt
N = 10000

on_time_count = 0
simulation_points = []
probability_points = []
for i in range(1, N + 1):

    traffic = random.randint(0, 100)
    weather = random.randint(0, 100)
    delay = random.randint(0, 100)
    if traffic < 70 and weather < 80 and delay < 50:
        on_time_count += 1
    if i % 100 == 0:
        probability = on_time_count / i

        simulation_points.append(i)
        probability_points.append(probability)

final_probability = on_time_count / N

print("Monte Carlo Simulation Results")
print("--------------------------------")
print("Total Simulations     :", N)
print("On-Time Deliveries    :", on_time_count)
print("Estimated Probability :", round(final_probability, 4))
print("Estimated Percentage  :", round(final_probability * 100, 2), "%")

plt.figure(figsize=(8, 5))

plt.plot(
    simulation_points,
    probability_points,
    marker='o',
    markersize=2
)

plt.xlabel("Number of Simulations")
plt.ylabel("Estimated Probability")
plt.title("Monte Carlo Sampling - Probability Estimation")

plt.grid(True)
plt.show()
